{
  "name": "rubio-cli-kit",
  "image": "ghcr.io/rubio-enterprises/rubio-cli-kit/devcontainer:main",
  "mounts": ["source=${devcontainerId}-venv,target=${containerWorkspaceFolder}/.venv,type=volume"],
  "securityOpt": ["no-new-privileges=false"],
  "onCreateCommand": "sudo chown vscode .venv && mise run setup",
  "remoteEnv": {
    "NODE_AUTH_TOKEN": "${localEnv:NODE_AUTH_TOKEN}"
  }
}
