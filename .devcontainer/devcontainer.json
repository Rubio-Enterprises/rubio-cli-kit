{
  "name": "rubio-cli-kit",
  "image": "mcr.microsoft.com/devcontainers/base:2.2.1-trixie",
  "features": {
    "ghcr.io/rubio-enterprises/devcontainer-features/baseline:3.0.1": {}
  },
  "mounts": [
    "source=${devcontainerId}-venv,target=${containerWorkspaceFolder}/.venv,type=volume"
  ],
  "securityOpt": ["no-new-privileges=false"],
  "onCreateCommand": "sudo chown vscode .venv",
  "updateContentCommand": "mise bootstrap --only repos,tools --yes && mise run setup"
}
