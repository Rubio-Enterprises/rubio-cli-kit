.DS_Store
.envrc.local
# Use .envrc.local for machine-local values
*.log
node_modules/
dist/
build/
coverage/
reports/

# .claude/: track settings.json and hooks/commands/agents, ignore local state. The leading
# `!.claude/` re-includes the directory when a global ignore shadows it.
!.claude/
.claude/*
!.claude/settings.json
!.claude/hooks/
!.claude/commands/
!.claude/agents/

# Per-stack
__pycache__/
*.pyc
.venv/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.ruff_cache/
.mypy_cache/
.tox/
.standards/
# Personal overlays (the repository config lives in mise.toml and lefthook.yml)
lefthook-local.yml
.mise.local.toml
